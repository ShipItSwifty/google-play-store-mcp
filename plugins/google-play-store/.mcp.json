{
  "mcpServers": {
    "google-play-store": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/start-server.sh",
      "args": [],
      "env": {
        "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON": "",
        "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH": "${user_config.service_account_path}",
        "GOOGLE_APPLICATION_CREDENTIALS": "",
